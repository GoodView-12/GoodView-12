---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import TagFilter from '../components/TagFilter.astro';
import { DEFAULT_COVER } from '../consts';
import { localizePath, t, type Locale } from '../i8n';
import Layout from '../layouts/Layout.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = t[locale];

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
const single = posts.length === 1;
---

<Layout title={copy.meta.blogTitle} description={copy.meta.blogDescription} locale={locale}>
	<section class="page container">
		<header class="page-head">
			<p class="eyebrow">{copy.blog.eyebrow}</p>
			<h1>{copy.blog.title}</h1>
			<p>{copy.blog.lead}</p>
		</header>

		<TagFilter
			tags={tags}
			total={posts.length}
			allLabel={copy.common.all}
			filterLabel={copy.blog.filterLabel}
			countTemplate={copy.common.countArticles}
		/>

		<div class:list={['card-grid', { 'card-grid--single': single }]} data-card-grid>
			{posts.map((post) => (
				<PostCard
					href={localizePath(`/blog/${post.id}/`, locale)}
					title={post.data.title}
					description={post.data.description}
					cover={post.data.cover ?? DEFAULT_COVER}
					tags={post.data.tags}
					date={post.data.pubDate}
					locale={locale}
				/>
			))}
		</div>

		{posts.length === 0 && <p class="empty">{copy.common.emptyBlog}</p>}
		{single && <p class="coming-soon">{copy.blog.comingSoon}</p>}
	</section>
</Layout>

<style>
	.page-head {
		animation: fadeUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.card-grid {
		animation: fadeUp 0.7s 0.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.card-grid--single {
		grid-template-columns: minmax(0, 860px);
		justify-content: center;
	}

	.empty,
	.coming-soon {
		padding: 26px 0;
		color: var(--ink-faint);
		font-size: 0.88rem;
		text-align: center;
	}

	.coming-soon {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		max-width: 860px;
		margin: 30px auto 0;
		padding: 22px;
		border: 1px dashed var(--line);
		border-radius: var(--radius);
		background: rgba(255, 253, 249, 0.6);
	}

	.coming-soon::before {
		content: '✦';
		color: var(--accent);
		animation: twinkle 3s ease-in-out infinite;
	}
</style>
