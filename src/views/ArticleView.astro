---
import Comments from '../components/Comments.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import {
	localizePath,
	normalizePath,
	resolveAsset,
	stripLocale,
	t,
	type Locale,
} from '../i8n';
import Layout from '../layouts/Layout.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	locale: Locale;
	kind: 'blog' | 'project';
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	cover?: string;
	tags?: string[];
	demo?: string;
	repo?: string;
	headings?: Heading[];
}

const {
	locale,
	kind,
	title,
	description,
	pubDate,
	updatedDate,
	cover,
	tags = [],
	demo,
	repo,
	headings = [],
} = Astro.props;

const copy = t[locale];
const isProject = kind === 'project';
const backHref = localizePath(isProject ? '/projects/' : '/blog/', locale);
const backLabel = isProject ? copy.common.backToProjects : copy.common.backToBlog;
const eyebrow = isProject ? copy.article.eyebrowProject : copy.article.eyebrowBlog;
const pageKey = normalizePath(stripLocale(Astro.url.pathname));
const tocVisible = headings.some((heading) => heading.depth === 2 || heading.depth === 3);
---

<Layout title={`${title} · ${copy.meta.siteName}`} description={description} locale={locale}>
	<article class="article">
		<div class="container article__inner">
			<a class="article__back" href={backHref}>← {backLabel}</a>

			<div class:list={['article__layout', { 'article__layout--single': !tocVisible }]}>
				{tocVisible && (
					<aside class="article__aside">
						<TableOfContents headings={headings} title={copy.article.tocTitle} locale={locale} />
					</aside>
				)}

				<div class="article__body">
					<header class="article__head">
						<p class="eyebrow">{eyebrow}</p>
						<h1>{title}</h1>
						<p class="article__desc">{description}</p>

						<div class="article__meta">
							<FormattedDate date={pubDate} locale={locale} />
							{updatedDate && (
								<>
									<span class="article__sep">·</span>
									<span>
										{copy.common.updatedOn}{' '}
										<FormattedDate date={updatedDate} locale={locale} />
									</span>
								</>
							)}
							{tags.length > 0 && <span class="article__sep">·</span>}
							{tags.map((tag) => (
								<a
									class="article__tag"
									href={`${backHref}?tag=${encodeURIComponent(tag)}`}
								>
									#{tag}
								</a>
							))}
						</div>
					</header>

					{(demo || repo) && (
						<div class="article__actions">
							{demo && (
								<a
									class="article__action article__action--primary"
									href={demo}
									target="_blank"
									rel="noopener noreferrer"
								>
									{copy.common.projectDemo} ↗
								</a>
							)}
							{repo && (
								<a
									class="article__action"
									href={repo}
									target="_blank"
									rel="noopener noreferrer"
								>
									{copy.common.projectRepo} ↗
								</a>
							)}
						</div>
					)}

					{cover && (
						<figure class="article__cover">
							<img
								src={resolveAsset(cover)}
								alt={title}
								width="1200"
								height="675"
								loading="eager"
								decoding="async"
							/>
						</figure>
					)}

					<div class="prose" data-article-prose data-anchor-label={copy.article.anchorLabel}>
						<slot />
					</div>

					{!isProject && <Comments locale={locale} pageKey={pageKey} title={title} />}

					<footer class="article__foot">
						<a class="btn btn--outline" href={backHref}>← {backLabel}</a>
					</footer>
				</div>
			</div>
		</div>
	</article>
</Layout>

<script>
	const attachHeadingAnchors = () => {
		const prose = document.querySelector('[data-article-prose]');
		if (!(prose instanceof HTMLElement)) return;

		const label = prose.dataset.anchorLabel || 'Section link';
		prose.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]').forEach((heading) => {
			if (heading.querySelector('.heading-anchor')) return;

			const anchor = document.createElement('a');
			anchor.className = 'heading-anchor';
			anchor.href = `#${heading.id}`;
			anchor.setAttribute(
				'aria-label',
				`${label}: ${heading.textContent?.trim() || heading.id}`,
			);
			anchor.textContent = '#';
			heading.append(anchor);
		});
	};

	attachHeadingAnchors();
</script>

<style>
	.article {
		padding: 28px 0 96px;
	}

	.article__inner {
		max-width: 1120px;
	}

	.article__layout {
		display: grid;
		grid-template-columns: 210px minmax(0, 820px);
		justify-content: center;
		align-items: start;
		gap: 36px;
	}

	.article__layout--single {
		grid-template-columns: minmax(0, 820px);
	}

	.article__aside {
		position: sticky;
		top: 118px;
	}

	.article__body {
		min-width: 0;
	}

	@media (max-width: 1080px) {
		.article__layout {
			grid-template-columns: minmax(0, 820px);
			gap: 22px;
		}

		.article__aside {
			position: static;
		}
	}

	.article__back {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-bottom: 26px;
		padding: 6px 14px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--card);
		color: var(--ink-soft);
		font-size: 0.82rem;
		text-decoration: none;
		transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
	}

	.article__back:hover {
		color: var(--accent-ink);
		border-color: var(--accent);
		background: var(--accent-soft);
	}

	.article__head {
		margin-bottom: 28px;
	}

	.article__head h1 {
		margin: 0 0 16px;
		font-size: clamp(2rem, 4.5vw, 3rem);
	}

	.article__desc {
		max-width: 640px;
		color: var(--ink-soft);
		font-size: 1.02rem;
	}

	.article__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-top: 16px;
		font-size: 0.8rem;
		color: var(--ink-faint);
	}

	.article__sep {
		color: var(--line);
	}

	.article__tag {
		padding: 2px 10px;
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--accent-ink);
		font-size: 0.74rem;
		text-decoration: none;
		transition: background 0.25s ease, color 0.25s ease;
	}

	.article__tag:hover {
		background: var(--accent);
		color: var(--on-accent);
	}

	.article__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 26px;
	}

	.article__action {
		display: inline-flex;
		align-items: center;
		padding: 8px 17px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--card);
		color: var(--ink);
		font-size: 0.84rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
	}

	.article__action:hover {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: var(--accent-ink);
	}

	.article__action--primary {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--on-accent);
	}

	.article__action--primary:hover {
		border-color: var(--accent-ink);
		background: var(--accent-ink);
		color: var(--on-accent);
	}

	.article__cover {
		margin: 0 0 38px;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--paper-soft);
	}

	.article__cover img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	.prose {
		color: var(--ink-soft);
		font-size: 1.02rem;
		line-height: 1.95;
	}

	.prose :global(h2) {
		margin: 2.2em 0 0.8em;
		padding-left: 14px;
		border-left: 4px solid var(--accent);
		color: var(--ink);
		font-size: 1.4rem;
	}

	.prose :global(h3) {
		margin: 1.8em 0 0.6em;
		color: var(--ink);
		font-size: 1.14rem;
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		scroll-margin-top: 120px;
	}

	.prose :global(:is(h2, h3, h4):target) {
		color: var(--accent-ink);
	}

	.prose :global(.heading-anchor) {
		display: inline-block;
		margin-left: 10px;
		color: var(--ink-faint);
		font-size: 0.8em;
		font-weight: 400;
		line-height: 1;
		text-decoration: none;
		opacity: 0.35;
		transition: opacity 0.2s ease, color 0.2s ease;
	}

	.prose :global(:is(h2, h3, h4):hover .heading-anchor),
	.prose :global(.heading-anchor:focus-visible) {
		opacity: 1;
	}

	.prose :global(.heading-anchor:hover) {
		color: var(--accent);
	}

	.prose :global(p) {
		margin: 0 0 1.2em;
	}

	.prose :global(a) {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.3em;
		margin: 0 0 1.2em;
	}

	.prose :global(li) {
		margin-bottom: 0.4em;
	}

	.prose :global(li)::marker {
		color: var(--accent);
	}

	.prose :global(blockquote) {
		margin: 1.6em 0;
		padding: 16px 20px;
		border-left: 3px solid var(--accent-2);
		border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
		background: var(--accent-2-soft);
		color: var(--ink-soft);
	}

	.prose :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.prose :global(code) {
		padding: 2px 7px;
		border-radius: 6px;
		background: var(--surface-muted);
		font-size: 0.9em;
	}

	.prose :global(pre) {
		margin: 1.5em 0;
		padding: 18px 20px;
		overflow-x: auto;
		border-radius: var(--radius-sm);
		background: var(--code-surface);
		color: var(--code-ink);
		font-size: 0.86rem;
		line-height: 1.7;
	}

	.prose :global(pre code) {
		padding: 0;
		background: none;
		font-size: inherit;
	}

	.prose :global(img) {
		margin: 1.5em 0;
		border-radius: var(--radius-sm);
	}

	.prose :global(hr) {
		margin: 2.4em 0;
		border: 0;
		border-top: 1px dashed var(--line);
	}

	.prose :global(table) {
		width: 100%;
		margin: 1.4em 0;
		border-collapse: collapse;
		font-size: 0.9rem;
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 9px 12px;
		border: 1px solid var(--line);
		text-align: left;
	}

	.prose :global(th) {
		background: var(--paper);
		color: var(--ink);
	}

	.article__foot {
		margin-top: 54px;
		padding-top: 24px;
		border-top: 1px dashed var(--line);
	}
</style>
