---
import FormattedDate from '../components/FormattedDate.astro';
import { localizePath, t, type Locale } from '../i8n';
import Layout from '../layouts/Layout.astro';

interface Props {
	locale: Locale;
	kind: 'blog' | 'project';
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	cover?: string;
	tags?: string[];
	demo?: string;
	repo?: string;
}

const {
	locale,
	kind,
	title,
	description,
	pubDate,
	updatedDate,
	cover,
	tags = [],
	demo,
	repo,
} = Astro.props;

const copy = t[locale];
const isProject = kind === 'project';
const backHref = localizePath(isProject ? '/projects' : '/blog', locale);
const backLabel = isProject ? copy.common.backToProjects : copy.common.backToBlog;
const eyebrow = isProject ? copy.article.eyebrowProject : copy.article.eyebrowBlog;
---

<Layout title={`${title} · ${copy.meta.siteName}`} description={description} locale={locale}>
	<article class="article">
		<div class="container article__inner">
			<a class="article__back" href={backHref}>← {backLabel}</a>

			<header class="article__head">
				<p class="eyebrow">{eyebrow}</p>
				<h1>{title}</h1>
				<p class="article__desc">{description}</p>

				<div class="article__meta">
					<FormattedDate date={pubDate} locale={locale} />
					{updatedDate && (
						<>
							<span class="article__sep">·</span>
							<span>
								{copy.common.updatedOn} <FormattedDate date={updatedDate} locale={locale} />
							</span>
						</>
					)}
					{tags.length > 0 && <span class="article__sep">·</span>}
					{tags.map((tag) => (
						<a class="article__tag" href={`${backHref}?tag=${encodeURIComponent(tag)}`}>
							#{tag}
						</a>
					))}
				</div>
			</header>

			{(demo || repo) && (
				<div class="article__actions">
					{demo && (
						<a class="article__action article__action--primary" href={demo} target="_blank" rel="noopener noreferrer">
							{copy.common.projectDemo} ↗
						</a>
					)}
					{repo && (
						<a class="article__action" href={repo} target="_blank" rel="noopener noreferrer">
							{copy.common.projectRepo} ↗
						</a>
					)}
				</div>
			)}

			{cover && (
				<figure class="article__cover">
					<img src={cover} alt={title} />
				</figure>
			)}

			<div class="prose">
				<slot />
			</div>

			<footer class="article__foot">
				<a class="btn btn--ghost" href={backHref}>← {backLabel}</a>
			</footer>
		</div>
	</article>
</Layout>

<style>
	.article {
		padding: 46px 0 96px;
	}

	.article__inner {
		max-width: 820px;
	}

	.article__back {
		display: inline-block;
		margin-bottom: 26px;
		font-size: 0.84rem;
		color: var(--ink-faint);
		text-decoration: none;
		transition: color 0.25s ease, transform 0.25s ease;
	}

	.article__back:hover {
		color: var(--accent);
		transform: translateX(-3px);
	}

	.article__head {
		margin-bottom: 28px;
	}

	.article__head h1 {
		margin: 0 0 16px;
		font-size: clamp(2rem, 4.5vw, 3rem);
	}

	.article__desc {
		max-width: 640px;
		color: var(--ink-soft);
		font-size: 1.02rem;
	}

	.article__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-top: 16px;
		font-size: 0.8rem;
		color: var(--ink-faint);
	}

	.article__sep {
		color: var(--line);
	}

	.article__tag {
		padding: 2px 10px;
		border-radius: 999px;
		background: var(--accent-soft);
		color: #b43c60;
		font-size: 0.74rem;
		text-decoration: none;
		transition: background 0.25s ease, color 0.25s ease;
	}

	.article__tag:hover {
		background: var(--accent);
		color: #fff;
	}

	.article__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 26px;
	}

	.article__action {
		display: inline-flex;
		align-items: center;
		padding: 9px 18px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: #fff;
		color: var(--ink);
		font-size: 0.84rem;
		font-weight: 600;
		text-decoration: none;
		transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
	}

	.article__action:hover {
		transform: translateY(-2px);
		border-color: var(--accent);
		background: var(--accent-soft);
	}

	.article__action--primary {
		border-color: transparent;
		background: var(--ink);
		color: #fff;
	}

	.article__action--primary:hover {
		border-color: transparent;
		background: #000;
	}

	.article__cover {
		margin: 0 0 38px;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
	}

	.article__cover img {
		width: 100%;
		aspect-ratio: 16 / 8;
		object-fit: cover;
	}

	.prose {
		color: var(--ink-soft);
		font-size: 1.02rem;
		line-height: 1.95;
	}

	.prose :global(h2) {
		margin: 2.2em 0 0.8em;
		padding-left: 14px;
		border-left: 4px solid var(--accent);
		color: var(--ink);
		font-size: 1.4rem;
	}

	.prose :global(h3) {
		margin: 1.8em 0 0.6em;
		color: var(--ink);
		font-size: 1.14rem;
	}

	.prose :global(p) {
		margin: 0 0 1.2em;
	}

	.prose :global(a) {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.3em;
		margin: 0 0 1.2em;
	}

	.prose :global(li) {
		margin-bottom: 0.4em;
	}

	.prose :global(li)::marker {
		color: var(--accent);
	}

	.prose :global(blockquote) {
		margin: 1.6em 0;
		padding: 16px 20px;
		border-left: 3px solid var(--accent-2);
		border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
		background: var(--accent-2-soft);
		color: var(--ink-soft);
	}

	.prose :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.prose :global(code) {
		padding: 2px 7px;
		border-radius: 6px;
		background: rgba(34, 34, 42, 0.06);
		font-size: 0.9em;
	}

	.prose :global(pre) {
		margin: 1.5em 0;
		padding: 18px 20px;
		overflow-x: auto;
		border-radius: var(--radius-sm);
		background: #24242c;
		color: #eceaf4;
		font-size: 0.86rem;
		line-height: 1.7;
	}

	.prose :global(pre code) {
		padding: 0;
		background: none;
		font-size: inherit;
	}

	.prose :global(img) {
		margin: 1.5em 0;
		border-radius: var(--radius-sm);
	}

	.prose :global(hr) {
		margin: 2.4em 0;
		border: 0;
		border-top: 1px dashed var(--line);
	}

	.prose :global(table) {
		width: 100%;
		margin: 1.4em 0;
		border-collapse: collapse;
		font-size: 0.9rem;
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 9px 12px;
		border: 1px solid var(--line);
		text-align: left;
	}

	.prose :global(th) {
		background: var(--paper);
		color: var(--ink);
	}

	.article__foot {
		margin-top: 54px;
		padding-top: 24px;
		border-top: 1px dashed var(--line);
	}
</style>
