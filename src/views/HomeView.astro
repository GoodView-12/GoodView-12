---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import WaveDivider from '../components/WaveDivider.astro';
import {
	AVATAR_IMAGE,
	AVATAR_IMAGE_SMALL,
	HERO_IMAGE,
	HERO_IMAGE_SMALL,
	SITE_LAUNCH_DATE,
	SITE_LAUNCH_DATE_LABEL,
	SOCIAL_LINKS,
	TOOL_LINK,
} from '../consts';
import { localizePath, t, type Locale } from '../i8n';
import Layout from '../layouts/Layout.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = t[locale];

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts[0];

const blogHref = localizePath('/blog/', locale);
const projectsHref = localizePath('/projects/', locale);
const aboutHref = localizePath('/about/', locale);

const updates = [
	...posts.map((post) => ({
		kind: 'blog' as const,
		title: post.data.title,
		date: post.data.pubDate,
		href: localizePath(`/blog/${post.id}/`, locale),
	})),
	...projects.map((project) => ({
		kind: 'project' as const,
		title: project.data.title,
		date: project.data.pubDate,
		href: localizePath(`/projects/${project.id}/`, locale),
	})),
]
	.sort((a, b) => b.date.valueOf() - a.date.valueOf())
	.slice(0, 3);

const launchDate = new Date(`${SITE_LAUNCH_DATE}T00:00:00`);
const daysSinceLaunch = Math.max(
	1,
	Math.floor((Date.now() - launchDate.getTime()) / 86_400_000),
);
---

<Layout title={copy.meta.homeTitle} description={copy.meta.homeDescription} locale={locale}>
	<section class="hero">
		<div class="hero__media">
			<img
				src={HERO_IMAGE}
				srcset={`${HERO_IMAGE_SMALL} 960w, ${HERO_IMAGE} 1920w`}
				sizes="100vw"
				width="1920"
				height="1018"
				alt={copy.a11y.heroImage}
				fetchpriority="high"
				decoding="async"
			/>
		</div>
		<div class="hero__veil"></div>
		<span class="hero__spark hero__spark--a" aria-hidden="true">✦</span>
		<span class="hero__spark hero__spark--b" aria-hidden="true">✦</span>
		<span class="hero__spark hero__spark--c" aria-hidden="true">✧</span>

		<div class="hero__content container">
			<p class="hero__kicker">{copy.home.heroKicker}</p>
			<h1 class="hero__title">{copy.home.heroTitle}</h1>
			<p class="hero__sub">{copy.home.heroSub}</p>
			<div class="hero__actions">
				<a class="btn btn--primary" href={blogHref}>
					{copy.home.heroPrimary} <span aria-hidden="true">→</span>
				</a>
				<a class="btn btn--ghost" href={projectsHref}>{copy.home.heroSecondary}</a>
			</div>
		</div>

		<p class="hero__scroll" aria-hidden="true">{copy.home.scroll}</p>
		<WaveDivider />
	</section>

	<section class="home container">
		<div class="bento">
			<article class="card card--profile">
				<div class="profile__top">
					<div class="profile__avatar">
						<img
							src={AVATAR_IMAGE}
							srcset={`${AVATAR_IMAGE_SMALL} 256w, ${AVATAR_IMAGE} 512w`}
							sizes="96px"
							width="512"
							height="512"
							alt={copy.a11y.avatar}
							loading="lazy"
							decoding="async"
						/>
						<span class="profile__status" title={copy.a11y.online}></span>
					</div>
					<p class="card-tag">{copy.home.profileTag}</p>
				</div>

				<div class="profile__intro">
					<h2>{copy.home.name}</h2>
					<p class="profile__handle">{copy.home.handle}</p>
					<p class="profile__bio">
						{copy.home.bio.map((line, index) => (
							<>
								{index > 0 && <br />}
								{line}
							</>
						))}
					</p>
				</div>

				<ul class="social-list">
					{SOCIAL_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								target={link.external ? '_blank' : undefined}
								rel="noopener noreferrer"
							>
								<span>{copy.common.social[link.key]}</span>
								<span class="social-list__arrow" aria-hidden="true">↗</span>
							</a>
						</li>
					))}
				</ul>
			</article>

			<a class="card card--blog" href={blogHref}>
				<span class="card-tag">{copy.home.blogTag}</span>
				<span class="card-spark card-spark--rose" aria-hidden="true">✦</span>
				<div class="card__grow">
					<h3>{latest ? latest.data.title : copy.home.blogFallbackTitle}</h3>
					<p>{latest ? latest.data.description : copy.home.blogFallbackDesc}</p>
				</div>
				<span class="card-link">{copy.common.allPosts} →</span>
			</a>

			<article
				class="card card--time"
				data-time-card
				data-launch-date={SITE_LAUNCH_DATE}
				data-lunar-prefix={copy.home.lunarPrefix}
			>
				<span class="card-tag">{copy.home.timeTag}</span>
				<span class="card-spark card-spark--amber" aria-hidden="true">✦</span>
				<div class="time-card__clock">
					<span data-clock>--:--</span>
					<small data-period>--</small>
				</div>
				<p class="time-card__date">
					<span data-date>--.--</span>
					<span class="time-card__sep" aria-hidden="true">·</span>
					<span data-lunar>{copy.home.lunarPrefix}--</span>
				</p>
				<p class="time-card__since" title={SITE_LAUNCH_DATE_LABEL}>
					{copy.home.sinceLabel}
					<strong data-site-days>{daysSinceLaunch}</strong>
					{copy.home.sinceUnit}
				</p>
				<span class="time-card__orb" data-sun aria-hidden="true">☀</span>
			</article>

			<article class="card card--projects">
				<span class="card-tag">{copy.home.projectsTag}</span>
				<span class="card-spark card-spark--blue" aria-hidden="true">✦</span>
				<div class="card__grow">
					<h3>{copy.home.projectsPickTitle}</h3>
					{projects.length > 0 ? (
						<ul class="project-picks">
							{projects.slice(0, 3).map((project) => (
								<li>
									<a
										class="project-pick"
										href={localizePath(`/projects/${project.id}/`, locale)}
									>
										<span class="project-pick__badge">
											{copy.home.recommendTag}
										</span>
										<span class="project-pick__name">{project.data.title}</span>
										<span class="project-pick__arrow" aria-hidden="true">
											↗
										</span>
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="project-picks__empty">{copy.common.emptyProjects}</p>
					)}
				</div>
				<a class="card-link" href={projectsHref}>{copy.home.projectsLink} →</a>
			</article>

			<a class="card card--tool" href={TOOL_LINK.href} target="_blank" rel="noopener noreferrer">
				<span class="card-tag">{copy.home.toolTag}</span>
				<span class="card-spark card-spark--amber" aria-hidden="true">✧</span>
				<span class="tool__glyph" aria-hidden="true">✦</span>
				<h3>
					{copy.home.toolTitle.map((line, index) => (
						<>
							{index > 0 && <br />}
							{line}
						</>
					))}
				</h3>
				<span class="card-link">{copy.home.toolLink} ↗</span>
			</a>

			<article class="card card--updates">
				<span class="card-tag">{copy.home.updatesTag}</span>
				<span class="card-spark card-spark--rose" aria-hidden="true">✧</span>
				<div class="card__grow">
					<h3>{copy.home.updatesTitle}</h3>
					{updates.length > 0 ? (
						<ul class="update-list">
							{updates.map((item) => (
								<li>
									<a class="update-item" href={item.href}>
										<span class:list={['update-item__type', `is-${item.kind}`]}>
											{item.kind === 'blog'
												? copy.nav.blog
												: copy.nav.projects}
										</span>
										<span class="update-item__title">{item.title}</span>
										<FormattedDate date={item.date} locale={locale} />
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="update-list__empty">{copy.home.updatesEmpty}</p>
					)}
				</div>
			</article>

			<article class="card card--stats">
				<span class="card-tag">{copy.home.statsTag}</span>
				<span class="card-spark card-spark--amber" aria-hidden="true">✦</span>
				<div class="stats-grid">
					<div class="stat">
						<strong>{posts.length}</strong>
						<span>{copy.home.statsPosts}</span>
					</div>
					<div class="stat">
						<strong>{projects.length}</strong>
						<span>{copy.home.statsProjects}</span>
					</div>
				</div>
				<a class="card-link" href={aboutHref}>{copy.home.statsLink} →</a>
				<span class="stats-ring" aria-hidden="true"></span>
			</article>
		</div>
	</section>
</Layout>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: min(88vh, 820px);
		padding: 90px 0 160px;
		overflow: hidden;
		background: #201a1c;
		color: #fffdf9;
	}

	.hero__media,
	.hero__veil {
		position: absolute;
		inset: 0;
	}

	.hero__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		animation: heroZoom 22s ease-in-out infinite alternate;
	}

	.hero__veil {
		background:
			linear-gradient(180deg, rgba(26, 20, 22, 0.66) 0%, rgba(26, 20, 22, 0.28) 46%, rgba(26, 20, 22, 0.7) 100%),
			linear-gradient(90deg, rgba(26, 20, 22, 0.6) 0%, rgba(26, 20, 22, 0) 72%);
	}

	.hero__content {
		position: relative;
		z-index: 3;
	}

	.hero__kicker {
		margin: 0 0 14px;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.34em;
		text-transform: uppercase;
		color: rgba(255, 253, 249, 0.72);
	}

	.hero__title {
		margin: 0 0 18px;
		font-size: clamp(3rem, 8.5vw, 6.4rem);
		font-weight: 700;
		letter-spacing: 0.1em;
		line-height: 1;
		text-shadow: 0 18px 46px rgba(26, 20, 22, 0.45);
	}

	.hero__sub {
		max-width: 460px;
		margin: 0 0 30px;
		font-size: clamp(0.95rem, 1.6vw, 1.08rem);
		color: rgba(255, 253, 249, 0.82);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.hero :global(.btn--primary) {
		background: var(--card);
		color: var(--ink);
	}

	.hero :global(.btn--primary:hover) {
		background: var(--accent-soft);
	}

	.hero :global(.btn--ghost) {
		background: rgba(255, 253, 249, 0.12);
		border-color: rgba(255, 253, 249, 0.4);
		color: #fffdf9;
		backdrop-filter: blur(6px);
	}

	.hero :global(.btn--ghost:hover) {
		background: rgba(255, 253, 249, 0.24);
		border-color: #fffdf9;
	}

	.hero__scroll {
		position: absolute;
		right: 34px;
		bottom: 130px;
		z-index: 3;
		margin: 0;
		font-size: 0.62rem;
		letter-spacing: 0.42em;
		color: rgba(255, 253, 249, 0.6);
		writing-mode: vertical-rl;
		animation: floatY 2.8s ease-in-out infinite;
	}

	.hero__spark {
		position: absolute;
		z-index: 3;
		animation: twinkle 3.4s ease-in-out infinite;
	}

	.hero__spark--a {
		top: 24%;
		left: 8%;
		font-size: 1.1rem;
	}

	.hero__spark--b {
		top: 28%;
		right: 12%;
		font-size: 1.7rem;
		color: var(--accent-4);
		animation-delay: 0.8s;
	}

	.hero__spark--c {
		bottom: 36%;
		left: 24%;
		font-size: 0.9rem;
		color: var(--accent-3);
		animation-delay: 1.6s;
	}

	@keyframes heroZoom {
		from {
			transform: scale(1);
		}
		to {
			transform: scale(1.08) translateY(-1%);
		}
	}

	.home {
		padding: 56px 0 104px;
	}

	.bento {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		grid-auto-rows: 100px;
		gap: 20px;
	}

	.bento > .card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		isolation: isolate;
		animation: bentoIn 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.bento > .card::before {
		content: '';
		position: absolute;
		right: -46px;
		bottom: -56px;
		z-index: -1;
		width: 160px;
		height: 160px;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			var(--card-glow, rgba(196, 111, 134, 0.14)),
			transparent 70%
		);
		pointer-events: none;
	}

	.bento > .card:nth-child(2) {
		animation-delay: 0.06s;
	}

	.bento > .card:nth-child(3) {
		animation-delay: 0.12s;
	}

	.bento > .card:nth-child(4) {
		animation-delay: 0.18s;
	}

	.bento > .card:nth-child(5) {
		animation-delay: 0.24s;
	}

	.bento > .card:nth-child(6) {
		animation-delay: 0.3s;
	}

	.bento > .card:nth-child(7) {
		animation-delay: 0.36s;
	}

	.bento > .card:nth-child(8) {
		animation-delay: 0.42s;
	}

	.card--profile {
		grid-column: 1 / span 2;
		grid-row: 1 / span 4;
		--card-glow: rgba(196, 111, 134, 0.16);
		transform: rotate(-1.1deg);
	}

	.card--blog {
		grid-column: 3 / span 2;
		grid-row: 1 / span 2;
		--card-glow: rgba(196, 111, 134, 0.13);
	}

	.card--time {
		grid-column: 5 / span 2;
		grid-row: 1 / span 2;
		--card-glow: rgba(211, 160, 92, 0.18);
		transform: rotate(0.8deg) translateY(6px);
	}

	.card--projects {
		grid-column: 3 / span 3;
		grid-row: 3 / span 2;
		--card-glow: rgba(114, 135, 163, 0.16);
		gap: 5px;
		padding: 18px 20px;
	}

	.card--tool {
		grid-column: 6;
		grid-row: 3 / span 2;
		--card-glow: rgba(211, 160, 92, 0.2);
		transform: rotate(-1.4deg);
	}

	.card--updates {
		grid-column: 1 / span 3;
		grid-row: 5 / span 2;
		--card-glow: rgba(114, 135, 163, 0.13);
	}

	.card--stats {
		grid-column: 4 / span 3;
		grid-row: 5 / span 2;
		--card-glow: rgba(211, 160, 92, 0.14);
		transform: rotate(-0.5deg);
	}

	.bento .card:hover {
		transform: translateY(-6px) rotate(0deg);
	}

	.card-tag {
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.26em;
		color: var(--ink-faint);
	}

	.card-link {
		margin-top: auto;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent);
	}

	.card__grow {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 6px;
	}

	.card__grow h3 {
		margin: 0;
		font-size: 1.2rem;
		line-height: 1.45;
		transition: color 0.25s ease;
	}

	.card--blog p,
	.card--projects p {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: var(--ink-soft);
		font-size: 0.84rem;
		line-height: 1.7;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.card--blog:hover h3,
	.card--projects:hover h3 {
		color: var(--accent);
	}

	.card--profile {
		gap: 14px;
		background: linear-gradient(160deg, var(--card) 0%, var(--card) 52%, var(--accent-soft) 145%);
	}

	.profile__top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
	}

	.profile__avatar {
		position: relative;
		width: 96px;
		height: 96px;
	}

	.profile__avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border: 3px solid var(--card);
		border-radius: 28px;
		box-shadow: 0 16px 30px -18px rgba(var(--shadow-rgb), 0.65);
		animation: floatY 5s ease-in-out infinite;
	}

	.profile__status {
		position: absolute;
		right: 2px;
		bottom: 2px;
		width: 15px;
		height: 15px;
		border: 3px solid var(--card);
		border-radius: 50%;
		background: var(--accent-3);
	}

	.profile__intro h2 {
		margin: 0;
		font-size: 1.5rem;
		letter-spacing: 0.04em;
	}

	.profile__handle {
		margin: 0;
		font-size: 0.76rem;
		letter-spacing: 0.1em;
		color: var(--ink-faint);
	}

	.profile__bio {
		margin: 8px 0 0;
		color: var(--ink-soft);
		font-size: 0.85rem;
		line-height: 1.7;
	}

	.social-list {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin: auto 0 0;
		padding: 0;
		list-style: none;
	}

	.social-list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 7px 12px;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: rgba(255, 253, 249, 0.72);
		color: var(--ink-soft);
		font-size: 0.8rem;
		text-decoration: none;
		transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease,
			transform 0.25s ease;
	}

	.social-list a:hover {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: var(--ink);
		transform: translateX(3px);
	}

	.social-list__arrow {
		opacity: 0.4;
		transition: opacity 0.25s ease, transform 0.25s ease;
	}

	.social-list a:hover .social-list__arrow {
		opacity: 1;
		transform: translate(2px, -2px);
	}

	@keyframes bentoIn {
		from {
			opacity: 0;
			translate: 0 20px;
		}
		to {
			opacity: 1;
			translate: 0 0;
		}
	}

	.card-spark {
		position: absolute;
		top: 12px;
		right: 14px;
		z-index: 2;
		color: var(--accent);
		font-size: 0.7rem;
		line-height: 1;
		opacity: 0.55;
		pointer-events: none;
		animation: twinkle 4s ease-in-out infinite;
	}

	.card-spark--amber {
		color: var(--accent-4);
		animation-delay: 0.6s;
	}

	.card-spark--blue {
		color: var(--accent-2);
		animation-delay: 1.2s;
	}

	.card-spark--rose {
		color: var(--accent);
	}

	.card--time {
		justify-content: center;
		gap: 4px;
	}

	.time-card__clock {
		display: flex;
		align-items: baseline;
		gap: 8px;
		margin: 2px 0 0;
		color: var(--ink);
		font-family: var(--font-display);
	}

	.time-card__clock [data-clock] {
		font-size: clamp(1.7rem, 2.8vw, 2.2rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.04em;
		font-variant-numeric: tabular-nums;
	}

	.time-card__clock small {
		color: var(--accent-ink);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.time-card__date {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		margin: 2px 0 0;
		color: var(--ink-soft);
		font-size: 0.8rem;
	}

	.time-card__date [data-date] {
		color: var(--ink);
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.time-card__sep {
		color: var(--accent-4);
	}

	.time-card__since {
		margin: 4px 0 0;
		color: var(--ink-faint);
		font-size: 0.74rem;
	}

	.time-card__since strong {
		margin: 0 2px;
		color: var(--accent-4-ink);
		font-size: 0.9rem;
	}

	.time-card__orb {
		position: absolute;
		right: 18px;
		bottom: 14px;
		color: var(--accent-4);
		font-size: 1.5rem;
		opacity: 0.35;
		pointer-events: none;
	}

	.card--projects h3 {
		font-size: 1.02rem;
	}

	.project-picks {
		display: flex;
		flex-direction: column;
		gap: 4px;
		margin: 4px 0 0;
		padding: 0;
		list-style: none;
	}

	.project-pick {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 5px 8px;
		border: 1px solid transparent;
		border-radius: 9px;
