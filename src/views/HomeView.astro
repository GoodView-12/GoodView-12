<script>
	const lunarDayNames = [
		'初一',
		'初二',
		'初三',
		'初四',
		'初五',
		'初六',
		'初七',
		'初八',
		'初九',
		'初十',
		'十一',
		'十二',
		'十三',
		'十四',
		'十五',
		'十六',
		'十七',
		'十八',
		'十九',
		'二十',
		'廿一',
		'廿二',
		'廿三',
		'廿四',
		'廿五',
		'廿六',
		'廿七',
		'廿八',
		'廿九',
		'三十',
	];

	const pad = (value: number) => String(value).padStart(2, '0');
	const toLunarDay = (day: number) => lunarDayNames[day - 1] || '';
	const lunarMonthNames = [
		'正月',
		'二月',
		'三月',
		'四月',
		'五月',
		'六月',
		'七月',
		'八月',
		'九月',
		'十月',
		'冬月',
		'腊月',
	];

	const normalizeLunarMonth = (value: string) => {
		const leap = value.includes('闰');
		const numeric = Number.parseInt(value.replace(/\D/g, ''), 10);
		if (!Number.isFinite(numeric) || numeric < 1 || numeric > 12) return value;
		return `${leap ? '闰' : ''}${lunarMonthNames[numeric - 1]}`;
	};

	let lunarFormatter: Intl.DateTimeFormat | null = null;
	try {
		lunarFormatter = new Intl.DateTimeFormat('zh-CN-u-ca-chinese', {
			month: 'long',
			day: 'numeric',
		});
	} catch {
		lunarFormatter = null;
	}

	const timeCards = document.querySelectorAll<HTMLElement>('[data-time-card]');

	if (timeCards.length > 0) {
		const updateTimeCards = () => {
			const now = new Date();
			const hours = now.getHours();
			const minutes = now.getMinutes();
			const hour12 = hours % 12 || 12;
			const period = hours >= 12 ? 'PM' : 'AM';

			timeCards.forEach((card) => {
				const clock = card.querySelector<HTMLElement>('[data-clock]');
				const periodEl = card.querySelector<HTMLElement>('[data-period]');
				const dateEl = card.querySelector<HTMLElement>('[data-date]');
				const lunarEl = card.querySelector<HTMLElement>('[data-lunar]');
				const daysEl = card.querySelector<HTMLElement>('[data-site-days]');
				const orb = card.querySelector<HTMLElement>('[data-sun]');

				if (clock) clock.textContent = `${pad(hour12)}:${pad(minutes)}`;
				if (periodEl) periodEl.textContent = period;
				if (dateEl) dateEl.textContent = `${pad(now.getMonth() + 1)}.${pad(now.getDate())}`;

				if (lunarEl && lunarFormatter) {
					const parts = lunarFormatter.formatToParts(now);
					const monthValue = parts.find((part) => part.type === 'month')?.value || '';
					const dayValue = parts.find((part) => part.type === 'day')?.value || '';
					const dayNumber = Number(dayValue);
					const dayText = Number.isFinite(dayNumber)
						? toLunarDay(dayNumber)
						: dayValue;
					const prefix = card.dataset.lunarPrefix || '';
					const spacer = /[A-Za-z]$/.test(prefix) ? ' ' : '';
					lunarEl.textContent = `${prefix}${spacer}${normalizeLunarMonth(monthValue)}${dayText}`;
				}

				if (daysEl && card.dataset.launchDate) {
					const launch = new Date(`${card.dataset.launchDate}T00:00:00`);
					if (!Number.isNaN(launch.getTime())) {
						const days = Math.max(
							1,
							Math.floor((now.getTime() - launch.getTime()) / 86_400_000),
						);
						daysEl.textContent = String(days);
					}
				}

				if (orb) orb.textContent = hours >= 6 && hours < 18 ? '☀' : '☾';
			});
		};

		updateTimeCards();
		window.setInterval(updateTimeCards, 15_000);
	}
</script>
