---
import { getCollection } from 'astro:content';
import WaveDivider from '../components/WaveDivider.astro';
import { AVATAR_IMAGE, HERO_IMAGE, SOCIAL_LINKS, TOOL_LINK } from '../consts';
import { localizePath, t, type Locale } from '../i8n';
import Layout from '../layouts/Layout.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = t[locale];

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const projects = await getCollection('projects');
const latest = posts[0];
const tagPool = [...new Set(posts.flatMap((post) => post.data.tags))].slice(0, 8);

const blogHref = localizePath('/blog', locale);
const projectsHref = localizePath('/projects', locale);
const dotTones = ['dot--pink', 'dot--blue', 'dot--mint'];
---

<Layout title={copy.meta.homeTitle} description={copy.meta.homeDescription} locale={locale}>
	<section class="hero">
		<div class="hero__media">
			<img src={HERO_IMAGE} alt={copy.a11y.heroImage} />
		</div>
		<div class="hero__veil"></div>
		<span class="hero__spark hero__spark--a" aria-hidden="true">✦</span>
		<span class="hero__spark hero__spark--b" aria-hidden="true">✦</span>
		<span class="hero__spark hero__spark--c" aria-hidden="true">✧</span>

		<div class="hero__content container">
			<p class="hero__kicker">{copy.home.heroKicker}</p>
			<h1 class="hero__title">{copy.home.heroTitle}</h1>
			<p class="hero__sub">{copy.home.heroSub}</p>
			<div class="hero__actions">
				<a class="btn btn--primary" href={blogHref}>
					{copy.home.heroPrimary} <span aria-hidden="true">→</span>
				</a>
				<a class="btn btn--ghost" href={projectsHref}>{copy.home.heroSecondary}</a>
			</div>
		</div>

		<p class="hero__scroll" aria-hidden="true">{copy.home.scroll}</p>
		<WaveDivider />
	</section>

	<section class="home container">
		<div class="bento">
			<article class="card card--profile">
				<div class="profile__top">
					<div class="profile__avatar">
						<img src={AVATAR_IMAGE} alt={copy.a11y.avatar} />
						<span class="profile__status" title={copy.a11y.online}></span>
					</div>
					<p class="card-tag">{copy.home.profileTag}</p>
				</div>

				<div class="profile__intro">
					<h2>{copy.home.name}</h2>
					<p class="profile__handle">{copy.home.handle}</p>
					<p class="profile__bio">
						{copy.home.bio.map((line, index) => (
							<>
								{index > 0 && <br />}
								{line}
							</>
						))}
					</p>
				</div>

				<ul class="social-list">
					{SOCIAL_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								target={link.external ? '_blank' : undefined}
								rel="noopener noreferrer"
							>
								<span>{copy.common.social[link.key]}</span>
								<span class="social-list__arrow" aria-hidden="true">↗</span>
							</a>
						</li>
					))}
				</ul>
			</article>

			<a class="card card--blog" href={blogHref}>
				<span class="card-tag">{copy.home.blogTag}</span>
				<div class="card__grow">
					<h3>{latest ? latest.data.title : copy.home.blogFallbackTitle}</h3>
					<p>{latest ? latest.data.description : copy.home.blogFallbackDesc}</p>
				</div>
				<span class="card-link">{copy.common.allPosts} →</span>
			</a>

			<article class="card card--now">
				<span class="card-tag">{copy.home.nowTag}</span>
				<ul class="now-list">
					{copy.home.nowItems.map((item, index) => (
						<li>
							<span class:list={['now-dot', dotTones[index % dotTones.length]]}></span>
							{item}
						</li>
					))}
				</ul>
			</article>

			<a class="card card--projects" href={projectsHref}>
				<span class="card-tag">{copy.home.projectsTag}</span>
				<div class="card__grow">
					<h3>{copy.home.projectsTitle(projects.length)}</h3>
					<p>{copy.home.projectsDesc}</p>
					<div class="mini-chips">
						{projects.slice(0, 3).map((project) => (
							<span class="mini-chip">{project.data.title}</span>
						))}
					</div>
				</div>
				<span class="card-link">{copy.home.projectsLink} →</span>
			</a>

			<a class="card card--tool" href={TOOL_LINK.href} target="_blank" rel="noopener noreferrer">
				<span class="card-tag">{copy.home.toolTag}</span>
				<span class="tool__glyph" aria-hidden="true">✦</span>
				<h3>
					{copy.home.toolTitle.map((line, index) => (
						<>
							{index > 0 && <br />}
							{line}
						</>
					))}
				</h3>
				<span class="card-link">{copy.home.toolLink} ↗</span>
			</a>

			<article class="card card--tags">
				<span class="card-tag">{copy.home.tagsTag}</span>
				<div class="mini-chips">
					{tagPool.map((tag) => (
						<a class="mini-chip" href={`${blogHref}?tag=${encodeURIComponent(tag)}`}>#{tag}</a>
					))}
				</div>
				<p class="tags-hint">{copy.home.tagsHint}</p>
				<span class="tags-mark" aria-hidden="true">#</span>
			</article>

			<article class="card card--note">
				<span class="card-tag">{copy.home.noteTag}</span>
				<p class="note__text">{copy.home.noteText}</p>
				<p class="note__sign">{copy.home.noteSign}</p>
				<span class="note__spark" aria-hidden="true">✦</span>
			</article>
		</div>
	</section>
</Layout>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: min(88vh, 820px);
		padding: 90px 0 160px;
		overflow: hidden;
		background: #191920;
		color: #fff;
	}

	.hero__media,
	.hero__veil {
		position: absolute;
		inset: 0;
	}

	.hero__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		animation: heroZoom 22s ease-in-out infinite alternate;
	}

	.hero__veil {
		background:
			linear-gradient(180deg, rgba(18, 18, 24, 0.66) 0%, rgba(18, 18, 24, 0.3) 46%, rgba(18, 18, 24, 0.7) 100%),
			linear-gradient(90deg, rgba(18, 18, 24, 0.6) 0%, rgba(18, 18, 24, 0) 72%);
	}

	.hero__content {
		position: relative;
		z-index: 3;
	}

	.hero__kicker {
		margin: 0 0 14px;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.34em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.72);
	}

	.hero__title {
		margin: 0 0 18px;
		font-size: clamp(3rem, 8.5vw, 6.4rem);
		font-weight: 700;
		letter-spacing: 0.1em;
		line-height: 1;
		text-shadow: 0 18px 46px rgba(0, 0, 0, 0.4);
	}

	.hero__sub {
		max-width: 460px;
		margin: 0 0 30px;
		font-size: clamp(0.95rem, 1.6vw, 1.08rem);
		color: rgba(255, 255, 255, 0.82);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.hero :global(.btn--primary) {
		background: #fff;
		color: var(--ink);
	}

	.hero :global(.btn--primary:hover) {
		background: var(--accent-soft);
	}

	.hero :global(.btn--ghost) {
		background: rgba(255, 255, 255, 0.12);
		border-color: rgba(255, 255, 255, 0.4);
		color: #fff;
		backdrop-filter: blur(6px);
	}

	.hero :global(.btn--ghost:hover) {
		background: rgba(255, 255, 255, 0.24);
		border-color: #fff;
	}

	.hero__scroll {
		position: absolute;
		right: 34px;
		bottom: 130px;
		z-index: 3;
		margin: 0;
		font-size: 0.62rem;
		letter-spacing: 0.42em;
		color: rgba(255, 255, 255, 0.6);
		writing-mode: vertical-rl;
		animation: floatY 2.8s ease-in-out infinite;
	}

	.hero__spark {
		position: absolute;
		z-index: 3;
		animation: twinkle 3.4s ease-in-out infinite;
	}

	.hero__spark--a {
		top: 24%;
		left: 8%;
		font-size: 1.1rem;
	}

	.hero__spark--b {
		top: 28%;
		right: 12%;
		font-size: 1.7rem;
		color: var(--accent-4);
		animation-delay: 0.8s;
	}

	.hero__spark--c {
		bottom: 36%;
		left: 24%;
		font-size: 0.9rem;
		color: var(--accent-3);
		animation-delay: 1.6s;
	}

	@keyframes heroZoom {
		from {
			transform: scale(1);
		}
		to {
			transform: scale(1.08) translateY(-1%);
		}
	}

	.home {
		padding: 56px 0 104px;
	}

	.bento {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		grid-auto-rows: 100px;
		gap: 20px;
	}

	.bento > .card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		animation: bentoIn 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.bento > .card:nth-child(2) {
		animation-delay: 0.06s;
	}

	.bento > .card:nth-child(3) {
		animation-delay: 0.12s;
	}

	.bento > .card:nth-child(4) {
		animation-delay: 0.18s;
	}

	.bento > .card:nth-child(5) {
		animation-delay: 0.24s;
	}

	.bento > .card:nth-child(6) {
		animation-delay: 0.3s;
	}

	.bento > .card:nth-child(7) {
		animation-delay: 0.36s;
	}

	.bento > .card:nth-child(8) {
		animation-delay: 0.42s;
	}

	.card--profile {
		grid-column: 1 / span 2;
		grid-row: 1 / span 4;
		transform: rotate(-1.1deg);
	}

	.card--blog {
		grid-column: 3 / span 2;
		grid-row: 1 / span 2;
	}

	.card--now {
		grid-column: 5 / span 2;
		grid-row: 1 / span 2;
		transform: rotate(1deg) translateY(8px);
	}

	.card--projects {
		grid-column: 3 / span 3;
		grid-row: 3 / span 2;
	}

	.card--tool {
		grid-column: 6;
		grid-row: 3 / span 2;
		transform: rotate(-1.4deg);
	}

	.card--tags {
		grid-column: 1 / span 3;
		grid-row: 5 / span 2;
	}

	.card--note {
		grid-column: 4 / span 3;
		grid-row: 5 / span 2;
		transform: rotate(-0.7deg);
	}

	.bento .card:hover {
		transform: translateY(-6px) rotate(0deg);
	}

	.card-tag {
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.26em;
		color: var(--ink-faint);
	}

	.card-link {
		margin-top: auto;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent);
	}

	.card__grow {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 6px;
	}

	.card__grow h3 {
		margin: 0;
		font-size: 1.2rem;
		line-height: 1.45;
		transition: color 0.25s ease;
	}

	.card--blog p,
	.card--projects p {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: var(--ink-soft);
		font-size: 0.84rem;
		line-height: 1.7;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.card--blog:hover h3,
	.card--projects:hover h3 {
		color: var(--accent);
	}

	.card--profile {
		gap: 14px;
		background: linear-gradient(160deg, #fff 0%, #fff 52%, var(--accent-soft) 145%);
	}

	.profile__top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
	}

	.profile__avatar {
		position: relative;
		width: 96px;
		height: 96px;
	}

	.profile__avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border: 3px solid #fff;
		border-radius: 28px;
		box-shadow: 0 16px 30px -18px rgba(34, 34, 42, 0.7);
		animation: floatY 5s ease-in-out infinite;
	}

	.profile__status {
		position: absolute;
		right: 2px;
		bottom: 2px;
		width: 15px;
		height: 15px;
		border: 3px solid #fff;
		border-radius: 50%;
		background: var(--accent-3);
	}

	.profile__intro h2 {
		margin: 0;
		font-size: 1.5rem;
		letter-spacing: 0.04em;
	}

	.profile__handle {
		margin: 0;
		font-size: 0.76rem;
		letter-spacing: 0.1em;
		color: var(--ink-faint);
	}

	.profile__bio {
		margin: 8px 0 0;
		color: var(--ink-soft);
		font-size: 0.85rem;
		line-height: 1.7;
	}

	.social-list {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin: auto 0 0;
		padding: 0;
		list-style: none;
	}

	.social-list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 7px 12px;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.65);
		color: var(--ink-soft);
		font-size: 0.8rem;
		text-decoration: none;
		transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease,
			transform 0.25s ease;
	}

	.social-list a:hover {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: var(--ink);
		transform: translateX(3px);
	}

	.social-list__arrow {
		opacity: 0.4;
		transition: opacity 0.25s ease, transform 0.25s ease;
	}

	.social-list a:hover .social-list__arrow {
		opacity: 1;
		transform: translate(2px, -2px);
	}

	@keyframes bentoIn {
		from {
			opacity: 0;
			translate: 0 20px;
		}
		to {
			opacity: 1;
			translate: 0 0;
		}
	}

	.now-list {
		display: flex;
		flex-direction: column;
		gap: 9px;
		margin: 6px 0 0;
		padding: 0;
		list-style: none;
		color: var(--ink-soft);
		font-size: 0.83rem;
	}

	.now-list li {
		display: flex;
		align-items: center;
		gap: 9px;
	}

	.now-dot {
		flex-shrink: 0;
		width: 7px;
		height: 7px;
		border-radius: 50%;
	}

	.dot--pink {
		background: var(--accent);
	}

	.dot--blue {
		background: var(--accent-2);
	}

	.dot--mint {
		background: var(--accent-3);
	}

	.mini-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 8px;
	}

	.mini-chip {
		display: inline-flex;
		align-items: center;
		padding: 4px 10px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--paper);
		color: var(--ink-soft);
		font-size: 0.7rem;
		line-height: 1.5;
		text-decoration: none;
		white-space: nowrap;
		transition: border-color 0.25s ease, background 0.25s ease, color 0.25s ease;
	}

	.mini-chip:hover {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: #b43c60;
	}

	.card--tool {
		background: linear-gradient(160deg, #fff 0%, var(--accent-2-soft) 160%);
	}

	.tool__glyph {
		margin: 2px 0;
		color: var(--accent-2);
		font-size: 1.9rem;
		line-height: 1;
		animation: twinkle 3s ease-in-out infinite;
	}

	.card--tool h3 {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.4;
	}

	.card--tags {
		background: linear-gradient(150deg, #fff 0%, #fff 58%, var(--accent-2-soft) 160%);
	}

	.card--tags .mini-chips {
		margin-top: 4px;
	}

	.tags-hint {
		position: relative;
		z-index: 1;
		margin: auto 0 0;
		font-size: 0.72rem;
		color: var(--ink-faint);
	}

	.tags-mark {
		position: absolute;
		right: -4px;
		bottom: -30px;
		z-index: 0;
		color: var(--accent-2-soft);
		font-family: var(--font-display);
		font-size: 6rem;
		font-weight: 700;
		line-height: 1;
		pointer-events: none;
	}

	.card--note {
		justify-content: center;
		border-color: transparent;
		background: linear-gradient(150deg, var(--ink) 0%, #34343f 100%);
		color: #fff;
	}

	.card--note .card-tag {
		color: rgba(255, 255, 255, 0.5);
	}

	.note__text {
		margin: 4px 0 0;
		font-family: var(--font-display);
		font-size: 1.16rem;
		letter-spacing: 0.04em;
	}

	.note__sign {
		margin: 0;
		color: rgba(255, 255, 255, 0.55);
		font-size: 0.76rem;
	}

	.note__spark {
		position: absolute;
		right: 18px;
		top: 16px;
		color: var(--accent-4);
		animation: twinkle 3.2s ease-in-out infinite;
	}

	@media (max-width: 1040px) {
		.bento {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-auto-rows: auto;
		}

		.bento > .card {
			grid-column: span 1;
			grid-row: auto;
			min-height: 190px;
			transform: none;
		}

		.bento > .card--profile {
			grid-column: 1 / -1;
			min-height: 0;
		}

		.bento > .card--projects,
		.bento > .card--note {
			grid-column: 1 / -1;
		}

		.bento > .card--tool {
			min-height: 170px;
		}
	}

	@media (max-width: 720px) {
		.hero {
			min-height: 78vh;
			padding: 64px 0 140px;
		}

		.hero__scroll {
			display: none;
		}

		.hero__spark--a {
			left: 5%;
		}
	}

	@media (max-width: 620px) {
		.bento {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.bento > .card {
			grid-column: span 1;
			min-height: 0;
		}

		.bento > .card--profile,
		.bento > .card--projects,
		.bento > .card--note {
			grid-column: span 1;
		}

		.home {
			padding: 40px 0 76px;
		}
	}
</style>
