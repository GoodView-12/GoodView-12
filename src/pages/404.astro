---
import { localizePath, t } from '../i8n';
import Layout from '../layouts/Layout.astro';

const locale = 'zh-CN' as const;
const copy = t[locale];
---

<Layout
	title={`404 · ${copy.meta.siteName}`}
	description={copy.notFound.lead}
	locale={locale}
	noindex
>
	<section class="page container not-found">
		<div class="not-found__card">
			<p class="eyebrow">{copy.notFound.eyebrow}</p>
			<p class="not-found__code" aria-hidden="true">404</p>
			<h1>{copy.notFound.title}</h1>
			<p class="not-found__lead">{copy.notFound.lead}</p>
			<div class="not-found__actions">
				<a class="btn btn--primary" href={localizePath('/', locale)}>{copy.notFound.home}</a>
				<a class="btn btn--ghost" href={localizePath('/blog/', locale)}>{copy.notFound.blog}</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.not-found {
		display: grid;
		min-height: min(72vh, 640px);
		place-items: center;
		padding-top: 40px;
	}

	.not-found__card {
		width: min(100%, 620px);
		padding: 44px 40px;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--card);
		text-align: center;
		animation: fadeUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.not-found__code {
		margin: 6px 0 -18px;
		color: var(--accent-soft);
		font-family: var(--font-display);
		font-size: clamp(5rem, 16vw, 8rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.04em;
	}

	.not-found h1 {
		margin: 0 0 12px;
		font-size: clamp(1.6rem, 4vw, 2.2rem);
	}

	.not-found__lead {
		max-width: 420px;
		margin: 0 auto 26px;
		color: var(--ink-soft);
		font-size: 0.94rem;
	}

	.not-found__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
	}

	@media (max-width: 520px) {
		.not-found__card {
			padding: 32px 22px;
		}
	}
</style>
