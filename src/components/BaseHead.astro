---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import {
	DEFAULT_LOCALE,
	HTML_LANG,
	LOCALES,
	localizePath,
	t,
	type Locale,
} from '../i8n';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	locale: Locale;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, locale, image = FallbackImage } = Astro.props;
const copy = t[locale];
const alternates = LOCALES.map((code) => ({
	code,
	href: new URL(localizePath(Astro.url.pathname, code), Astro.site).href,
}));
const xDefault = new URL(localizePath(Astro.url.pathname, DEFAULT_LOCALE), Astro.site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={copy.meta.author} />
<meta name="theme-color" content="#f6f5f1" />

<Font cssVariable="--font-atkinson" preload />

<link rel="canonical" href={canonicalURL} />
{alternates.map((alternate) => (
	<link rel="alternate" hreflang={HTML_LANG[alternate.code]} href={alternate.href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefault} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={copy.meta.siteName} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
<meta property="og:locale" content={locale === 'zh-TW' ? 'zh_TW' : locale === 'en' ? 'en_US' : 'zh_CN'} />

<meta name="twitter:card" content="summary_large_image" />
