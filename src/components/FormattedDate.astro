---
import { INTL_LOCALE, type Locale } from '../i8n';

interface Props {
	date: Date;
	locale: Locale;
}

const { date, locale } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString(INTL_LOCALE[locale], {
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
	})}
</time>
