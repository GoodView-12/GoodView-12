---
import { NAV_ITEMS } from '../consts';
import {
	HTML_LANG,
	LOCALE_NAME,
	LOCALE_SHORT,
	LOCALES,
	localizePath,
	normalizePath,
	stripBase,
	t,
	type Locale,
} from '../i8n';
import HeaderLink from './HeaderLink.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = t[locale];
const currentPath = stripBase(Astro.url.pathname);
// 404 页面没有对应的多语言版本，语言切换回到各语言首页。
const languageSource = normalizePath(currentPath) === '/404' ? '/' : currentPath;
const langLinks = LOCALES.map((code) => ({
	code,
	short: LOCALE_SHORT[code],
	name: LOCALE_NAME[code],
	href: localizePath(languageSource, code),
	active: code === locale,
}));
---

<header class="site-header" data-header>
	<div class="nav-island container">
		<span class="brand">{copy.meta.brandName}</span>

		<nav class="nav-links" aria-label={copy.a11y.mainNav}>
			{NAV_ITEMS.map((item) => (
				<HeaderLink href={localizePath(item.path, locale)}>{copy.nav[item.key]}</HeaderLink>
			))}
		</nav>

		<div class="lang-switch" role="group" aria-label={copy.a11y.langSwitch}>
			{langLinks.map((link) => (
				<a
					class:list={['lang-switch__item', { 'is-active': link.active }]}
					href={link.href}
					hreflang={HTML_LANG[link.code]}
					lang={HTML_LANG[link.code]}
					title={link.name}
					aria-label={link.name}
					aria-current={link.active ? 'true' : undefined}
					data-lang-link
				>
					{link.short}
				</a>
			))}
		</div>
	</div>
</header>

<script>
	const header = document.querySelector('[data-header]');
	const syncHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
	syncHeader();
	window.addEventListener('scroll', syncHeader, { passive: true });

	document.querySelectorAll('[data-lang-link]').forEach((link) => {
		const url = new URL(link.getAttribute('href') || '/', window.location.origin);
		if (window.location.search) url.search = window.location.search;
		link.setAttribute('href', `${url.pathname}${url.search}`);
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 60;
		padding: 18px 0 16px;
		pointer-events: none;
	}

	.nav-island {
		display: flex;
		align-items: center;
		gap: 16px;
		max-width: 1040px;
		padding: 9px 12px 9px 22px;
		pointer-events: auto;
		background: var(--paper);
		border: 1px solid rgba(255, 253, 249, 0.8);
		border-radius: 22px;
		box-shadow:
			-7px -7px 16px rgba(255, 253, 249, 0.95),
			12px 14px 30px rgba(var(--shadow-rgb), 0.14),
			inset 0 1px 0 rgba(255, 253, 249, 0.85);
		transition: background 0.35s ease, box-shadow 0.35s ease, transform 0.35s ease;
	}

	.site-header.is-scrolled .nav-island {
		background: rgba(246, 241, 233, 0.92);
		backdrop-filter: blur(14px) saturate(1.15);
		-webkit-backdrop-filter: blur(14px) saturate(1.15);
		box-shadow:
			-6px -6px 14px rgba(255, 253, 249, 0.85),
			10px 16px 36px rgba(var(--shadow-rgb), 0.18),
			inset 0 1px 0 rgba(255, 253, 249, 0.75);
	}

	.brand {
		flex-shrink: 0;
		color: var(--ink);
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		white-space: nowrap;
		text-shadow: 0 1px 0 #fffdf9;
		user-select: none;
	}

	.nav-links {
		display: flex;
		flex: 1;
		align-items: center;
		justify-content: center;
		gap: 4px;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.nav-links::-webkit-scrollbar {
		display: none;
	}

	.lang-switch {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		gap: 2px;
		padding: 4px;
		border-radius: 999px;
		background: var(--paper);
		box-shadow:
			inset 3px 3px 7px rgba(var(--shadow-rgb), 0.1),
			inset -3px -3px 7px rgba(255, 253, 249, 0.95);
	}

	.lang-switch__item {
		padding: 4px 10px;
		border-radius: 999px;
		color: var(--ink-soft);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
		transition: color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
	}

	.lang-switch__item:hover {
		color: var(--ink);
	}

	.lang-switch__item.is-active {
		color: var(--accent-ink);
		background: var(--paper);
		box-shadow:
			2px 2px 5px rgba(var(--shadow-rgb), 0.14),
			-2px -2px 5px rgba(255, 253, 249, 0.95);
	}

	@media (max-width: 860px) {
		.nav-island {
			gap: 10px;
			padding: 8px 10px 8px 16px;
		}

		.brand {
			font-size: 0.9rem;
			letter-spacing: 0.04em;
		}
	}

	@media (max-width: 640px) {
		.site-header {
			padding-top: 10px;
			padding-bottom: 14px;
		}

		.nav-island {
			gap: 8px;
			padding: 7px 7px 7px 12px;
			border-radius: 18px;
		}

		.brand {
			font-size: 0.78rem;
			letter-spacing: 0.01em;
		}

		.lang-switch {
			padding: 3px;
		}

		.lang-switch__item {
			padding: 4px 7px;
			font-size: 0.64rem;
		}
	}

	@media (max-width: 560px) {
		.nav-island {
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 8px 10px;
			padding: 8px 12px;
		}

		.brand {
			order: 1;
			font-size: 0.84rem;
			letter-spacing: 0.02em;
		}

		.lang-switch {
			order: 2;
			margin-left: auto;
		}

		.nav-links {
			order: 3;
			flex: 1 0 100%;
			justify-content: center;
			gap: 2px;
		}
	}

	@media (max-width: 420px) {
		.nav-island {
			gap: 7px 8px;
			padding: 7px 10px;
		}

		.brand {
			font-size: 0.8rem;
			letter-spacing: 0;
		}

		.lang-switch__item {
			padding: 4px 6px;
		}
	}
</style>
