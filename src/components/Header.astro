---
import { NAV_ITEMS } from '../consts';
import {
	HTML_LANG,
	LOCALE_NAME,
	LOCALE_SHORT,
	LOCALES,
	localizePath,
	normalizePath,
	stripBase,
	t,
	type Locale,
} from '../i8n';
import HeaderLink from './HeaderLink.astro';

interface Props {
	locale: Locale;
	/** true 时导航脱离文档流，悬浮在页面顶部内容（首页头图）之上 */
	overlay?: boolean;
}

const { locale, overlay = false } = Astro.props;
const copy = t[locale];
const currentPath = stripBase(Astro.url.pathname);
// 404 页面没有对应的多语言版本，语言切换回到各语言首页。
const languageSource = normalizePath(currentPath) === '/404' ? '/' : currentPath;
const langLinks = LOCALES.map((code) => ({
	code,
	short: LOCALE_SHORT[code],
	name: LOCALE_NAME[code],
	href: localizePath(languageSource, code),
	active: code === locale,
}));
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
	<div class="nav-island container">
		<span class="brand">{copy.meta.brandName}</span>

		<nav class="nav-links" aria-label={copy.a11y.mainNav}>
			{NAV_ITEMS.map((item) => (
				<HeaderLink href={localizePath(item.path, locale)}>{copy.nav[item.key]}</HeaderLink>
			))}
		</nav>

		<button
			class="theme-toggle"
			type="button"
			data-theme-toggle
			aria-label={copy.a11y.themeToggle}
			title={copy.a11y.themeToggle}
			aria-pressed="false"
		>
			<svg
				class="theme-toggle__icon theme-toggle__icon--sun"
				viewBox="0 0 24 24"
				aria-hidden="true"
				focusable="false"
			>
				<circle cx="12" cy="12" r="4.2"></circle>
				<path
					d="M12 2.6v2.1M12 19.3v2.1M4.1 12H2M22 12h-2.1M5.9 5.9 4.4 4.4M19.6 19.6l-1.5-1.5M18.1 5.9l1.5-1.5M4.4 19.6l1.5-1.5"
				></path>
			</svg>
			<svg
				class="theme-toggle__icon theme-toggle__icon--moon"
				viewBox="0 0 24 24"
				aria-hidden="true"
				focusable="false"
			>
				<path d="M20.2 13.6A8.6 8.6 0 0 1 10.4 3.8a8.6 8.6 0 1 0 9.8 9.8Z"></path>
			</svg>
		</button>

		<div class="lang-switch" role="group" aria-label={copy.a11y.langSwitch}>
			{langLinks.map((link) => (
				<a
					class:list={['lang-switch__item', { 'is-active': link.active }]}
					href={link.href}
					hreflang={HTML_LANG[link.code]}
					lang={HTML_LANG[link.code]}
					title={link.name}
					aria-label={link.name}
					aria-current={link.active ? 'true' : undefined}
					data-lang-link
				>
					{link.short}
				</a>
			))}
		</div>
	</div>
</header>

<script>
	import { getActiveTheme, toggleTheme, watchSystemTheme } from '../scripts/theme';

	const header = document.querySelector('[data-header]');
	const syncHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
	syncHeader();
	window.addEventListener('scroll', syncHeader, { passive: true });

	const themeToggle = document.querySelector('[data-theme-toggle]');
	const syncThemeToggle = (theme = getActiveTheme()) => {
		if (!(themeToggle instanceof HTMLButtonElement)) return;
		themeToggle.setAttribute('aria-pressed', String(theme === 'dark'));
	};

	syncThemeToggle();
	themeToggle?.addEventListener('click', () => syncThemeToggle(toggleTheme()));
	watchSystemTheme((theme) => syncThemeToggle(theme));

	document.querySelectorAll('[data-lang-link]').forEach((link) => {
		const url = new URL(link.getAttribute('href') || '/', window.location.origin);
		if (window.location.search) url.search = window.location.search;
		link.setAttribute('href', `${url.pathname}${url.search}`);
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 60;
		padding: 18px 0 16px;
		pointer-events: none;
	}

	/* 首页：导航浮在头图之上，头图从页面最顶部开始 */
	.site-header--overlay {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
	}

	.nav-island {
		display: flex;
		align-items: center;
		gap: 14px;
		max-width: 1040px;
		padding: 8px 10px 8px 20px;
		pointer-events: auto;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		transition: background 0.2s ease, border-color 0.2s ease;
	}

	.site-header.is-scrolled .nav-island {
		background: var(--header-surface);
		border-color: var(--line-strong);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	/* 浮在头图上时保持半透明，让图片透出一点层次 */
	.site-header--overlay .nav-island {
		background: var(--header-surface);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.brand {
		flex-shrink: 0;
		color: var(--ink);
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		white-space: nowrap;
		user-select: none;
	}

	.theme-toggle {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--card);
		color: var(--ink-soft);
		transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}

	.theme-toggle:hover {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: var(--accent-ink);
	}

	.theme-toggle__icon {
		width: 17px;
		height: 17px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.theme-toggle__icon--moon {
		display: none;
	}

	:global(html[data-theme='dark']) .theme-toggle__icon--sun {
		display: none;
	}

	:global(html[data-theme='dark']) .theme-toggle__icon--moon {
		display: block;
	}

	.nav-links {
		display: flex;
		flex: 1;
		align-items: center;
		justify-content: center;
		gap: 4px;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.nav-links::-webkit-scrollbar {
		display: none;
	}

	.lang-switch {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		gap: 2px;
		padding: 3px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--surface-muted);
	}

	.lang-switch__item {
		padding: 4px 10px;
		border-radius: 999px;
		color: var(--ink-soft);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
		transition: color 0.2s ease, background 0.2s ease;
	}

	.lang-switch__item:hover {
		color: var(--ink);
		background: var(--card);
	}

	.lang-switch__item.is-active {
		color: var(--accent-ink);
		background: var(--accent-soft);
	}

	@media (max-width: 860px) {
		.nav-island {
			gap: 10px;
			padding: 8px 10px 8px 16px;
		}

		.brand {
			font-size: 0.9rem;
			letter-spacing: 0.04em;
		}
	}

	@media (max-width: 640px) {
		.site-header {
			padding-top: 10px;
			padding-bottom: 14px;
		}

		.nav-island {
			gap: 8px;
			padding: 7px 7px 7px 12px;
			border-radius: var(--radius);
		}

		.brand {
			font-size: 0.78rem;
			letter-spacing: 0.01em;
		}

		.theme-toggle {
			width: 30px;
			height: 30px;
		}

		.lang-switch {
			padding: 2px;
		}

		.lang-switch__item {
			padding: 4px 7px;
			font-size: 0.64rem;
		}
	}

	@media (max-width: 560px) {
		.nav-island {
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 8px 10px;
			padding: 8px 12px;
		}

		.brand {
			order: 1;
			font-size: 0.84rem;
			letter-spacing: 0.02em;
		}

		.lang-switch {
			order: 2;
			margin-left: auto;
		}

		.theme-toggle {
			order: 3;
		}

		.nav-links {
			order: 4;
			flex: 1 0 100%;
			justify-content: center;
			gap: 2px;
		}
	}

	@media (max-width: 420px) {
		.nav-island {
			gap: 7px 8px;
			padding: 7px 10px;
		}

		.brand {
			font-size: 0.8rem;
			letter-spacing: 0;
		}

		.lang-switch__item {
			padding: 4px 6px;
		}
	}
</style>
