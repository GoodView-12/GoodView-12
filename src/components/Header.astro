---
import { NAV_ITEMS } from '../consts';
import {
	HTML_LANG,
	LOCALE_NAME,
	LOCALE_SHORT,
	LOCALES,
	localizePath,
	t,
	type Locale,
} from '../i8n';
import HeaderLink from './HeaderLink.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = t[locale];
const homeHref = localizePath('/', locale);
const langLinks = LOCALES.map((code) => ({
	code,
	short: LOCALE_SHORT[code],
	name: LOCALE_NAME[code],
	href: localizePath(Astro.url.pathname, code),
	active: code === locale,
}));
---

<header class="site-header">
	<div class="nav-island container">
		<a class="brand" href={homeHref} aria-label={copy.a11y.homeLink}>
			<span class="brand__glyph" aria-hidden="true">{copy.meta.logoGlyph}</span>
			<span class="brand__text">
				<strong>{copy.meta.siteName}</strong>
				<small>{copy.meta.siteLatin}</small>
			</span>
		</a>

		<nav class="nav-links" aria-label={copy.a11y.mainNav}>
			{NAV_ITEMS.map((item, index) => (
				<HeaderLink href={localizePath(item.path, locale)}>
					<span class="nav-index">{String(index + 1).padStart(2, '0')}</span>
					<span>{copy.nav[item.key]}</span>
				</HeaderLink>
			))}
		</nav>

		<div class="lang-switch" role="group" aria-label={copy.a11y.langSwitch}>
			{langLinks.map((link) => (
				<a
					class:list={['lang-switch__item', { 'is-active': link.active }]}
					href={link.href}
					hreflang={HTML_LANG[link.code]}
					lang={HTML_LANG[link.code]}
					title={link.name}
					aria-label={link.name}
					aria-current={link.active ? 'true' : undefined}
					data-lang-link
				>
					{link.short}
				</a>
			))}
		</div>
	</div>
</header>

<script>
	const header = document.querySelector('.site-header');
	const syncHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 10);
	syncHeader();
	window.addEventListener('scroll', syncHeader, { passive: true });

	document.querySelectorAll('[data-lang-link]').forEach((link) => {
		const url = new URL(link.getAttribute('href') || '/', window.location.origin);
		if (window.location.search) url.search = window.location.search;
		link.setAttribute('href', `${url.pathname}${url.search}`);
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 60;
		padding: 14px 0 0;
		pointer-events: none;
	}

	.nav-island {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 8px 10px 8px 14px;
		pointer-events: auto;
		background: rgba(251, 250, 247, 0.82);
		border: 1px solid rgba(229, 226, 218, 0.9);
		border-radius: 999px;
		backdrop-filter: blur(18px) saturate(1.3);
		-webkit-backdrop-filter: blur(18px) saturate(1.3);
		box-shadow: 0 18px 40px -30px rgba(34, 34, 42, 0.55);
		transition: background 0.3s ease, box-shadow 0.3s ease;
	}

	.site-header.is-scrolled .nav-island {
		background: rgba(251, 250, 247, 0.95);
		box-shadow: 0 22px 44px -26px rgba(34, 34, 42, 0.6);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		flex-shrink: 0;
		text-decoration: none;
	}

	.brand__glyph {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 12px;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		color: #fff;
		font-family: var(--font-display);
		font-size: 0.98rem;
		font-weight: 700;
		box-shadow: 0 10px 20px -12px rgba(255, 122, 156, 0.9);
		transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), border-radius 0.45s ease;
	}

	.brand:hover .brand__glyph {
		transform: rotate(-12deg) scale(1.05);
		border-radius: 50%;
	}

	.brand__text {
		display: flex;
		flex-direction: column;
		line-height: 1.08;
	}

	.brand__text strong {
		font-family: var(--font-display);
		font-size: 0.98rem;
		letter-spacing: 0.05em;
	}

	.brand__text small {
		margin-top: 2px;
		font-size: 0.53rem;
		font-weight: 600;
		letter-spacing: 0.3em;
		color: var(--ink-faint);
	}

	.nav-links {
		display: flex;
		flex: 1;
		align-items: center;
		justify-content: center;
		gap: 2px;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.nav-links::-webkit-scrollbar {
		display: none;
	}

	.lang-switch {
		display: flex;
		align-items: center;
		gap: 2px;
		flex-shrink: 0;
		padding: 3px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: #fff;
	}

	.lang-switch__item {
		padding: 4px 9px;
		border-radius: 999px;
		color: var(--ink-soft);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
		transition: color 0.25s ease, background 0.25s ease;
	}

	.lang-switch__item:hover {
		color: var(--ink);
		background: var(--accent-soft);
	}

	.lang-switch__item.is-active {
		color: #fff;
		background: var(--ink);
	}

	@media (max-width: 640px) {
		.site-header {
			padding-top: 8px;
		}

		.nav-island {
			gap: 8px;
			padding: 6px 6px 6px 8px;
		}

		.brand__glyph {
			width: 32px;
			height: 32px;
			border-radius: 10px;
			font-size: 0.9rem;
		}

		.brand__text {
			display: none;
		}

		.lang-switch {
			padding: 2px;
		}

		.lang-switch__item {
			padding: 4px 6px;
			font-size: 0.66rem;
		}
	}

	@media (max-width: 480px) {
		.brand {
			display: none;
		}

		.nav-links {
			gap: 0;
		}

		.lang-switch__item {
			padding: 4px 5px;
		}
	}
</style>
