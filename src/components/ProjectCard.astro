---
import { getStatusLabel, resolveAsset, t, type Locale } from '../i8n';

interface Props {
	href: string;
	title: string;
	description: string;
	cover: string;
	tags?: string[];
	status?: string;
	demo?: string;
	repo?: string;
	locale: Locale;
}

const {
	href,
	title,
	description,
	cover,
	tags = [],
	status = 'done',
	demo,
	repo,
	locale,
} = Astro.props;

const copy = t[locale];
const tone = ['idea', 'doing', 'done', 'archived'].includes(status) ? status : 'done';
const statusLabel = getStatusLabel(locale, tone);
---

<article class="project-card" data-card data-tags={tags.join('|')}>
	<a class="project-card__media" href={href} aria-label={title}>
		<img src={resolveAsset(cover)} alt={title} width="1200" height="675" loading="lazy" decoding="async" />
		<span class:list={['project-card__status', `is-${tone}`]}>{statusLabel}</span>
	</a>

	<div class="project-card__body">
		<h3 class="project-card__title">
			<a href={href}>{title}</a>
		</h3>
		<p class="project-card__desc">{description}</p>

		{tags.length > 0 && (
			<div class="project-card__tags">
				{tags.map((tag) => <span class="project-card__tag">#{tag}</span>)}
			</div>
		)}

		<div class="project-card__links">
			{demo && (
				<a class="project-card__action" href={demo} target="_blank" rel="noopener noreferrer">
					{copy.common.projectDemoShort} ↗
				</a>
			)}
			{repo && (
				<a class="project-card__action" href={repo} target="_blank" rel="noopener noreferrer">
					{copy.common.projectRepoShort} ↗
				</a>
			)}
			<a class="project-card__more" href={href}>{copy.common.detail} →</a>
		</div>
	</div>
</article>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		box-shadow: var(--shadow-neu);
		overflow: hidden;
		transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s ease,
			border-color 0.35s ease;
	}

	.project-card:hover {
		transform: translateY(-6px);
		border-color: rgba(var(--shadow-rgb), 0.18);
		box-shadow: var(--shadow-neu-hover);
	}

	.project-card__media {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: linear-gradient(135deg, var(--accent-2-soft), var(--accent-soft));
	}

	.project-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.project-card:hover .project-card__media img {
		transform: scale(1.06);
	}

	.project-card__status {
		position: absolute;
		left: 14px;
		top: 14px;
		padding: 4px 11px;
		border-radius: 999px;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		background: rgba(255, 253, 249, 0.92);
		color: var(--ink);
		backdrop-filter: blur(6px);
	}

	.project-card__status.is-doing {
		color: var(--accent-4-ink);
		background: rgba(211, 160, 92, 0.88);
	}

	.project-card__status.is-done {
		color: var(--accent-3-ink);
		background: rgba(138, 160, 136, 0.9);
	}

	.project-card__status.is-idea {
		color: #6d2f41;
		background: rgba(196, 111, 134, 0.9);
	}

	.project-card__status.is-archived {
		color: var(--paper-soft);
		background: rgba(96, 89, 96, 0.9);
	}

	.project-card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 10px;
		padding: 18px 20px 20px;
	}

	.project-card__title {
		margin: 0;
		font-size: 1.16rem;
	}

	.project-card__title a {
		color: var(--ink);
		text-decoration: none;
		transition: color 0.25s ease;
	}

	.project-card:hover .project-card__title a {
		color: var(--accent);
	}

	.project-card__desc {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: var(--ink-soft);
		font-size: 0.88rem;
		line-height: 1.7;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.project-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.project-card__tag {
		padding: 2px 9px;
		border-radius: 999px;
		background: var(--paper);
		color: var(--ink-faint);
		font-size: 0.72rem;
	}

	.project-card__links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px;
		margin-top: auto;
		padding-top: 10px;
		border-top: 1px dashed var(--line);
		font-size: 0.8rem;
	}

	.project-card__links a {
		color: var(--ink-soft);
		text-decoration: none;
		transition: color 0.25s ease;
	}

	.project-card__links a:hover {
		color: var(--accent);
	}

	.project-card__action {
		display: inline-flex;
		align-items: center;
		gap: 3px;
		padding: 4px 10px;
		border-radius: 999px;
		background: var(--paper);
		color: var(--ink-soft);
		box-shadow:
			-3px -3px 7px rgba(255, 253, 249, 0.9),
			4px 4px 9px rgba(var(--shadow-rgb), 0.1),
			inset 1px 1px 0 rgba(255, 253, 249, 0.9);
		transition: color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}

	.project-card__action:hover {
		color: var(--accent-ink);
		transform: translateY(-1px);
		box-shadow:
			-4px -4px 9px rgba(255, 253, 249, 0.95),
			6px 7px 14px rgba(var(--shadow-rgb), 0.13),
			inset 1px 1px 0 rgba(255, 253, 249, 0.95);
	}

	.project-card__more {
		margin-left: auto;
		font-weight: 600;
	}

	@media (min-width: 900px) {
		:global(.card-grid--single) .project-card {
			display: grid;
			grid-template-columns: 1.05fr 1fr;
		}

		:global(.card-grid--single) .project-card__media {
			height: 100%;
			aspect-ratio: auto;
		}

		:global(.card-grid--single) .project-card__body {
			justify-content: center;
			padding: 28px 30px;
		}

		:global(.card-grid--single) .project-card__title {
			font-size: 1.5rem;
		}
	}
</style>
