---
import { resolveAsset, type Locale } from '../i8n';
import FormattedDate from './FormattedDate.astro';

interface Props {
	href: string;
	title: string;
	description: string;
	cover: string;
	tags?: string[];
	date: Date;
	locale: Locale;
}

const { href, title, description, cover, tags = [], date, locale } = Astro.props;
---

<article class="post-card" data-card data-tags={tags.join('|')}>
	<a class="post-card__link" href={href}>
		<div class="post-card__media">
			<img
				src={resolveAsset(cover)}
				alt={title}
				width="1200"
				height="675"
				loading="lazy"
				decoding="async"
			/>
			<span class="post-card__arrow" aria-hidden="true">↗</span>
		</div>
		<div class="post-card__body">
			<div class="post-card__meta">
				<FormattedDate date={date} locale={locale} />
				{tags.length > 0 && <span class="post-card__sep">·</span>}
				{tags.slice(0, 2).map((tag) => <span class="post-card__tag">#{tag}</span>)}
			</div>
			<h3 class="post-card__title">{title}</h3>
			<p class="post-card__desc">{description}</p>
		</div>
	</a>
</article>

<style>
	.post-card {
		display: flex;
		height: 100%;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		box-shadow: var(--shadow-neu);
		overflow: hidden;
		transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s ease,
			border-color 0.35s ease;
	}

	.post-card:hover {
		transform: translateY(-6px);
		border-color: rgba(var(--shadow-rgb), 0.18);
		box-shadow: var(--shadow-neu-hover);
	}

	.post-card__link {
		display: flex;
		flex-direction: column;
		width: 100%;
		color: var(--ink);
		text-decoration: none;
	}

	.post-card__media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: linear-gradient(135deg, var(--accent-soft), var(--accent-2-soft));
	}

	.post-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.4s ease;
	}

	.post-card:hover .post-card__media img {
		transform: scale(1.06);
		filter: saturate(1.08);
	}

	.post-card__arrow {
		position: absolute;
		right: 14px;
		bottom: 14px;
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: rgba(255, 253, 249, 0.92);
		color: var(--ink);
		font-size: 0.9rem;
		opacity: 0;
		transform: translateY(6px);
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	.post-card:hover .post-card__arrow {
		opacity: 1;
		transform: none;
	}

	.post-card__body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 18px 20px 22px;
	}

	.post-card__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		font-size: 0.74rem;
		color: var(--ink-faint);
	}

	.post-card__sep {
		color: var(--line);
	}

	.post-card__tag {
		color: var(--accent);
		font-weight: 600;
	}

	.post-card__title {
		margin: 0;
		font-size: 1.16rem;
		line-height: 1.4;
		transition: color 0.25s ease;
	}

	.post-card:hover .post-card__title {
		color: var(--accent);
	}

	.post-card__desc {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: var(--ink-soft);
		font-size: 0.88rem;
		line-height: 1.7;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	@media (min-width: 900px) {
		:global(.card-grid--single) .post-card__link {
			flex-direction: row;
		}

		:global(.card-grid--single) .post-card__media {
			width: 48%;
			aspect-ratio: auto;
			min-height: 100%;
		}

		:global(.card-grid--single) .post-card__body {
			justify-content: center;
			width: 52%;
			padding: 28px 30px;
		}

		:global(.card-grid--single) .post-card__title {
			font-size: 1.5rem;
		}
	}
</style>
