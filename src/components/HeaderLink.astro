---
import type { HTMLAttributes } from 'astro/types';
import { normalizePath, stripLocale } from '../i8n';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = stripLocale(Astro.url.pathname);
const current = normalizePath(pathname);
const target = normalizePath(stripLocale(href || '/'));
const currentRoot = '/' + (current.match(/[^\/]+/g)?.[0] || '');
const isActive = target === current || target === currentRoot;
---

<a
	href={href}
	class:list={['nav-link', className, { 'is-active': isActive }]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
</a>

<style>
	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 7px 14px;
		border-radius: var(--radius-sm);
		color: var(--ink-soft);
		font-size: 0.86rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease, background 0.2s ease;
	}

	.nav-link:hover {
		color: var(--ink);
		background: var(--surface-muted);
	}

	.nav-link.is-active {
		color: var(--accent-ink);
		background: var(--accent-soft);
		font-weight: 700;
	}

	@media (max-width: 640px) {
		.nav-link {
			gap: 4px;
			padding: 7px 10px;
			font-size: 0.78rem;
		}
	}

	@media (max-width: 480px) {
		.nav-link {
			padding: 6px 7px;
			font-size: 0.74rem;
		}
	}
</style>
