---
import type { HTMLAttributes } from 'astro/types';
import { normalizePath, stripLocale } from '../i8n';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = stripLocale(Astro.url.pathname);
const current = normalizePath(pathname);
const target = normalizePath(stripLocale(href || '/'));
const currentRoot = '/' + (current.match(/[^\/]+/g)?.[0] || '');
const isActive = target === current || target === currentRoot;
---

<a
	href={href}
	class:list={['nav-link', className, { 'is-active': isActive }]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
</a>

<style>
	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 8px 16px;
		border-radius: 14px;
		color: var(--ink-soft);
		font-size: 0.86rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease,
			transform 0.25s ease;
	}

	.nav-link:hover {
		color: var(--ink);
		box-shadow:
			-3px -3px 7px rgba(255, 253, 249, 0.9),
			4px 4px 10px rgba(var(--shadow-rgb), 0.1);
		transform: translateY(-1px);
	}

	.nav-link.is-active {
		color: var(--accent-ink);
		box-shadow:
			inset 3px 3px 7px rgba(var(--shadow-rgb), 0.12),
			inset -3px -3px 7px rgba(255, 253, 249, 0.95);
	}

	.nav-link.is-active:hover {
		transform: none;
	}

	@media (max-width: 640px) {
		.nav-link {
			gap: 4px;
			padding: 7px 10px;
			font-size: 0.78rem;
		}
	}

	@media (max-width: 480px) {
		.nav-link {
			padding: 6px 7px;
			font-size: 0.74rem;
		}
	}
</style>
