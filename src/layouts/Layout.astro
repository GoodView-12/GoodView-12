---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { HTML_LANG, t, type Locale } from '../i8n';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;
const copy = t[locale];
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
	<head>
		<BaseHead locale={locale} title={title} description={description} noindex={noindex} />
	</head>
	<body>
		<a class="skip-link" href="#main">{copy.a11y.skip}</a>
		<Header locale={locale} />
		<main id="main">
			<slot />
		</main>
		<Footer locale={locale} />
	</body>
</html>
